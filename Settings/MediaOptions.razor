@* Opções do widget Mídia. *@
<MudStack Spacing="3">
    <MudSelect T="string" Value="@Instance.Input" ValueChanged="v => Instance.SetInputAsync(v)" Label="Fonte de mídia"
               Variant="Variant.Outlined" Style="min-width:280px"
               HelperText="Fontes de mídia e de VLC. Toque dá play e pause; segure para reiniciar.">
        @foreach (var input in Instance.AvailableInputs)
        {
            <MudSelectItem Value="@input.Name">@input.Name</MudSelectItem>
        }
        @if (Instance.Input is { } chosen && Instance.AvailableInputs.All(i => i.Name != chosen))
        {
            <MudSelectItem Value="@chosen">@($"{chosen} · não existe agora")</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public MediaInstance Instance { get; set; } = default!;
}
