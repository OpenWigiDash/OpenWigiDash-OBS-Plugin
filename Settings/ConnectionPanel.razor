@implements IDisposable

@* Uma conexão com o obs-websocket: nome, endereço, porta e senha, com o estado dela. A página do plugin mostra uma
   destas para cada conexão salva, e uma em branco ao adicionar. *@
<MudPaper Outlined="true" Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.subtitle1">@(IsNew ? "Nova conexão" : Connection.Name)</MudText>
            @if (IsDefault)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Padrão</MudChip>
            }
        </MudStack>

        @if (Session is { } session)
        {
            <MudAlert Severity="@ConnectionStatus.StateSeverity(session)" Dense="true" Variant="Variant.Outlined">
                @ConnectionStatus.Text(session)
                @if (session.ConnectionState is not (ObsConnectionState.Ready or ObsConnectionState.Connecting) && session.LastError is { } error)
                {
                    <MudText Typo="Typo.caption" Style="display:block;opacity:.8">Detalhe: @error</MudText>
                    <MudText Typo="Typo.caption" Style="display:block;opacity:.8">Log: %LOCALAPPDATA%\OpenWigiDash\WidgetData\OBS\obs.log</MudText>
                }
            </MudAlert>
        }

        <MudTextField T="string" @bind-Value="_name" Label="Nome" Variant="Variant.Outlined" Style="max-width:320px"
                      HelperText="Como aparece na escolha da conexão de cada widget. Ex.: Este PC, PC da live." />

        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
            <MudTextField T="string" @bind-Value="_host" Label="Endereço" Variant="Variant.Outlined" Style="min-width:200px"
                          Immediate="true"
                          HelperText="127.0.0.1 quando o OBS roda neste PC. Em outro PC da rede, o IP ou o nome dele." />
            <MudNumericField T="int" @bind-Value="_port" Label="Porta" Variant="Variant.Outlined" Min="1" Max="65535"
                             HideSpinButtons="true" Style="max-width:120px" />
        </MudStack>

        <MudTextField T="string" @bind-Value="_password" Label="Senha do servidor WebSocket" Variant="Variant.Outlined"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="() => _showPassword = !_showPassword"
                      HelperText="@PasswordHelp" />

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Salvar e conectar</MudButton>
            @if (TypedIsLocal)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search" OnClick="Detect">Detectar neste PC</MudButton>
            }
            @if (IsNew)
            {
                <MudButton Variant="Variant.Text" OnClick="OnCancel">Cancelar</MudButton>
            }
            else
            {
                @if (Session is { } s)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="s.Reconnect">Tentar de novo</MudButton>
                }
                @if (!IsDefault)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Star" OnClick="OnMakeDefault">Tornar padrão</MudButton>
                }
                @if (CanRemove)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="Remove">
                        @(_confirmRemove ? "Clique de novo para remover" : "Remover")
                    </MudButton>
                }
            }
        </MudStack>

        @if (_confirmRemove)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">Os widgets ligados a esta conexão passam para a padrão.</MudText>
        }
        @if (_message is { } message)
        {
            <MudText Typo="Typo.caption" Color="@(_messageOk ? Color.Success : Color.Warning)">@message</MudText>
        }
    </MudStack>
</MudPaper>

@code {
    /// <summary>A conexão como está salva (numa nova, os valores iniciais).</summary>
    [Parameter, EditorRequired]
    public ObsConnection Connection { get; set; } = default!;

    /// <summary>Sessão da conexão, para mostrar o estado. <c>null</c> numa conexão ainda não salva.</summary>
    [Parameter]
    public ObsSession? Session { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool IsDefault { get; set; }

    [Parameter]
    public bool CanRemove { get; set; }

    [Parameter]
    public EventCallback<ObsConnection> OnSave { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public EventCallback OnMakeDefault { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string? _name;
    private string? _host;
    private int _port;
    private string? _password;
    private bool _showPassword;
    private bool _confirmRemove;
    private string? _message;
    private bool _messageOk;
    private ObsSession? _watched;

    protected override void OnInitialized() =>
        (_name, _host, _port, _password) = (Connection.Name, Connection.Endpoint.Host, Connection.Endpoint.Port, Connection.Endpoint.Password);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_watched, Session))
            return;
        if (_watched is not null)
            _watched.Changed -= OnChanged;
        _watched = Session;
        if (_watched is not null)
            _watched.Changed += OnChanged;
    }

    public void Dispose()
    {
        if (_watched is not null)
            _watched.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>"Detectar" e o texto da senha dependem de o endereço digitado ser deste PC.</summary>
    private bool TypedIsLocal => string.IsNullOrWhiteSpace(_host) || new ObsEndpoint(_host.Trim(), ObsEndpoint.DefaultPort, null).IsLocal;

    private string PasswordHelp => TypedIsLocal
        ? "No OBS: Ferramentas > Configurações do servidor WebSocket > Mostrar informações de conexão. Fica guardada criptografada só para o seu usuário do Windows."
        : "No OBS do outro PC: Ferramentas > Configurações do servidor WebSocket > Mostrar informações de conexão. Lá, a porta precisa estar liberada no firewall do Windows. Fica guardada criptografada só para o seu usuário do Windows.";

    private async Task Save()
    {
        var host = string.IsNullOrWhiteSpace(_host) ? ObsEndpoint.Default.Host : _host.Trim();
        var port = _port is > 0 and <= 65535 ? _port : ObsEndpoint.DefaultPort;
        var endpoint = new ObsEndpoint(host, port, string.IsNullOrEmpty(_password) ? null : _password);
        var name = string.IsNullOrWhiteSpace(_name) ? (endpoint.IsLocal ? ObsConnectionStore.LocalName : host) : _name.Trim();
        (_name, _host, _port) = (name, host, port);
        _confirmRemove = false;
        Show("Salvo. Conectando…", ok: true);
        await OnSave.InvokeAsync(Connection with { Name = name, Endpoint = endpoint });
    }

    private async Task Remove()
    {
        if (!_confirmRemove)
        {
            _confirmRemove = true;
            return;
        }
        _confirmRemove = false;
        await OnRemove.InvokeAsync();
    }

    /// <summary>Lê a configuração do obs-websocket deste PC, só quando a pessoa pede.</summary>
    private void Detect()
    {
        if (ObsLocalConfig.TryRead() is not { } config)
        {
            Show("Não achei a configuração do OBS neste PC. O OBS 28 ou mais novo está instalado?", ok: false);
            return;
        }
        _host = ObsEndpoint.Default.Host;
        _port = config.Port;
        _password = config.AuthRequired ? config.Password : null;
        Show(config.Enabled
            ? "Achei a porta e a senha. Confira e clique em Salvar e conectar."
            : "Achei, mas o servidor WebSocket está desligado. No OBS: Ferramentas > Configurações do servidor WebSocket > Ativar.",
            ok: config.Enabled);
    }

    private void Show(string text, bool ok) => (_message, _messageOk) = (text, ok);
}
